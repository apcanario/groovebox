{
  "name": "groovebox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single --outDir dist-single",
    "preview": "vite preview",
    "check": "tsc --noEmit && vitest run && vite build",
    "smoke": "vite build && python3 tools/smoke.py dist",
    "test": "vitest run",
    "record-test": "vite build && python3 tools/record_long.py dist 10"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "preact": "^10.29.8",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
